   "roundness": null,
   "seed": 428,
   "version": 1,
   "versionNonce": 794,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "Classpath + META-INF/services \u2014 NOT JPMS. On the\nmodule path ServiceLoader reads provides..with and\nignores META-INF entirely; mixing them silently\nfinds nothing. Classpath + an ArchUnit rule gives\nthe same guarantee with no module-info ceremony.\n\nProviders must be public with a public no-arg ctor.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Classpath + META-INF/services \u2014 NOT JPMS. On the\nmodule path ServiceLoader reads provides..with and\nignores META-INF entirely; mixing them silently\nfinds nothing. Classpath + an ArchUnit rule gives\nthe same guarantee with no module-info ceremony.\n\nProviders must be public with a public no-arg ctor.",
   "lineHeight": 1.25
  },
