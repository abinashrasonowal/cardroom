  {
   "id": "t49",
   "type": "text",
   "x": 82,
   "y": 1284,
   "width": 458,
   "height": 65,
   "angle": 0,
   "strokeColor": "#0f766e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
