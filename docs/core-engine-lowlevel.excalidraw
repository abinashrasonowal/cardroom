   "link": null,
   "locked": false,
   "text": "sealed interface Validation permits Ok, Reject\nrecord Reject(ErrorCode code, String detail)\nrecord Turn(PlayerId actor, Duration limit)\ninterface PlayerView {}        marker: must serialize",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sealed interface Validation permits Ok, Reject\nrecord Reject(ErrorCode code, String detail)\nrecord Turn(PlayerId actor, Duration limit)\ninterface PlayerView {}        marker: must serialize",
   "lineHeight": 1.25
  },
