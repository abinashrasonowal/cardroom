   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "Actor-per-room single writer  \u00b7  deeply immutable state  \u00b7  games discovered at runtime via ServiceLoader  \u00b7  engine-core has no compile-time knowledge of any game",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Actor-per-room single writer  \u00b7  deeply immutable state  \u00b7  games discovered at runtime via ServiceLoader  \u00b7  engine-core has no compile-time knowledge of any game",
   "lineHeight": 1.25
  },
