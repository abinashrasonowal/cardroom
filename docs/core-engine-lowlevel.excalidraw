   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "Implemented in :server.\nengine-core declares these itself \u2014\nit never imports ws / jdbc / Spring.\nThat inversion is what makes the\nengine testable with no I/O.\n\nNo custom Clock type: java.time.Clock\nalready has Clock.fixed() as the\ntest double.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Implemented in :server.\nengine-core declares these itself \u2014\nit never imports ws / jdbc / Spring.\nThat inversion is what makes the\nengine testable with no I/O.\n\nNo custom Clock type: java.time.Clock\nalready has Clock.fixed() as the\ntest double.",
   "lineHeight": 1.25
  },
