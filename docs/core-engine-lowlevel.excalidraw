   "roundness": null,
   "seed": 344,
   "version": 1,
   "versionNonce": 638,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "These live in the CONTRACT, not the core. EngineContext exposes\nRandomSource, so placing it in engine-core would make the\ncontract depend on the core \u2014 a compile cycle \u2014 and would\nleave a game module unable to name a playing card.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "These live in the CONTRACT, not the core. EngineContext exposes\nRandomSource, so placing it in engine-core would make the\ncontract depend on the core \u2014 a compile cycle \u2014 and would\nleave a game module unable to name a playing card.",
   "lineHeight": 1.25
  },
