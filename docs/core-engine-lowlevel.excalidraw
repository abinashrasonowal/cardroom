   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "interface Intent { }      interface GameEvent { }\nrecord PlayerId(String v)   record RoomCode(String v)\nrecord Seat(int i, PlayerId id, String nick,\n            Set<SocketId> sockets)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "interface Intent { }      interface GameEvent { }\nrecord PlayerId(String v)   record RoomCode(String v)\nrecord Seat(int i, PlayerId id, String nick,\n            Set<SocketId> sockets)",
   "lineHeight": 1.25
  },
  {
   "id": "t11",
   "type": "text",
   "x": 82,
   "y": 785,
   "width": 458,
   "height": 48,
   "angle": 0,
   "strokeColor": "#7e22ce",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 78,
   "version": 1,
   "versionNonce": 144,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "parseIntent / turn / options / isHandComplete exist because the\nalternative is editing the core when game #2 arrives.\nproject() is the ONLY redaction point in the system.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "parseIntent / turn / options / isHandComplete exist because the\nalternative is editing the core when game #2 arrives.\nproject() is the ONLY redaction point in the system.",
   "lineHeight": 1.25
  },
