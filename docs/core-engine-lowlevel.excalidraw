   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "sealed interface Command permits\n  Join, Leave, Disconnect, Reconnect, Submit,\n  Timeout, TransferHost, Kick, Start, Close\nrecord Submit(PlayerId, JsonNode, String msgId)\nrecord Timeout(long armedAtSeq, PlayerId actor)\n  ONLY Submit reaches the game module",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sealed interface Command permits\n  Join, Leave, Disconnect, Reconnect, Submit,\n  Timeout, TransferHost, Kick, Start, Close\nrecord Submit(PlayerId, JsonNode, String msgId)\nrecord Timeout(long armedAtSeq, PlayerId actor)\n  ONLY Submit reaches the game module",
   "lineHeight": 1.25
  },
