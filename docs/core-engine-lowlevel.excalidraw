   "text": "\u00abinterface\u00bb EngineContext\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlong         now()        from java.time.Clock\nRandomSource random()     seeded, replayable\nList<Seat>   seats()",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u00abinterface\u00bb EngineContext\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nlong         now()        from java.time.Clock\nRandomSource random()     seeded, replayable\nList<Seat>   seats()",
   "lineHeight": 1.25
  },
