   "text": "final class GameCatalog\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- Map<String, GameDefinition<?,?,?>> byId\n+ static GameCatalog discover()\n    ServiceLoader.load(GameDefinition.class)\n+ GameDefinition<?,?,?> require(String gameId)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "final class GameCatalog\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- Map<String, GameDefinition<?,?,?>> byId\n+ static GameCatalog discover()\n    ServiceLoader.load(GameDefinition.class)\n+ GameDefinition<?,?,?> require(String gameId)",
   "lineHeight": 1.25
  },
  {
   "id": "t61",
   "type": "text",
   "x": 1322,
   "y": 1098,
   "width": 372,
   "height": 113,
   "angle": 0,
   "strokeColor": "#7e22ce",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
