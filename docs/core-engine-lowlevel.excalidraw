   "versionNonce": 352,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "final class RoomActor implements Runnable\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- BlockingQueue<Command> inbox =\n      new ArrayBlockingQueue<>(256)    BOUNDED\n- Thread w = Thread.ofVirtual()\n      .name(\"room-\"+code).start(this)\n- Room room   - GameSession<?,?,?> session\n+ boolean offer(Command c)\n      false -> gateway closes the socket\n- void run()  take(); try/catch RuntimeException\n      -> log, broadcast faulted, close. Never die\n      silently. Drops Timeout if armedAtSeq != seq",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "final class RoomActor implements Runnable\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n- BlockingQueue<Command> inbox =\n      new ArrayBlockingQueue<>(256)    BOUNDED\n- Thread w = Thread.ofVirtual()\n      .name(\"room-\"+code).start(this)\n- Room room   - GameSession<?,?,?> session\n+ boolean offer(Command c)\n      false -> gateway closes the socket\n- void run()  take(); try/catch RuntimeException\n      -> log, broadcast faulted, close. Never die\n      silently. Drops Timeout if armedAtSeq != seq",
   "lineHeight": 1.25
  },
