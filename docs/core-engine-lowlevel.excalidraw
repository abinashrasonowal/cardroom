   "versionNonce": 716,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "final class HmacRandom implements RandomSource\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nhandSeed = HMAC-SHA256(serverSeed,\n     clientSeed1||..||clientSeedN||handIndex)\nbytes    = HMAC-SHA256(handSeed, counter++)",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "final class HmacRandom implements RandomSource\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nhandSeed = HMAC-SHA256(serverSeed,\n     clientSeed1||..||clientSeedN||handIndex)\nbytes    = HMAC-SHA256(handSeed, counter++)",
   "lineHeight": 1.25
  },
  {
   "id": "t56",
   "type": "text",
   "x": 742,
   "y": 1220,
   "width": 408,
   "height": 113,
   "angle": 0,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 393,
   "version": 1,
   "versionNonce": 729,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1770000000000,
   "link": null,
   "locked": false,
   "text": "NOT SplittableRandom \u2014 its only ctor takes a long, so\n32 secure bytes collapse to 8, and JS has no equivalent,\nso /verify could not re-derive the deal. HMAC-SHA256 is\ntwelve lines of WebCrypto in any browser, forever.\n\nClient seeds stop a server grinding candidate seeds and\ncommitting only to the one it likes.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "NOT SplittableRandom \u2014 its only ctor takes a long, so\n32 secure bytes collapse to 8, and JS has no equivalent,\nso /verify could not re-derive the deal. HMAC-SHA256 is\ntwelve lines of WebCrypto in any browser, forever.\n\nClient seeds stop a server grinding candidate seeds and\ncommitting only to the one it likes.",
   "lineHeight": 1.25
  },
